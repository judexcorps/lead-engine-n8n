# This file lists WHAT you need. It contains NO real values. Never commit a real .env.
# In n8n, these live inside n8n Credentials, not in this file.
# The file exists so a reader knows what to set up.

# Supabase (Session pooler, because the direct connection is IPv6 only)
SUPABASE_DB_HOST=aws-1-REGION.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.PROJECT-REF
SUPABASE_DB_PASSWORD=your-database-password

# Gemini (Google AI Studio free tier)
GEMINI_API_KEY=your-gemini-key

# Tavily (free search API)
# n8n Header Auth: name = Authorization, value = Bearer your-tavily-key
TAVILY_API_KEY=your-tavily-key

# Gmail uses OAuth inside n8n (no key here)
NOTIFY_EMAIL=you@example.com
