      "parameters": {
        "jsCode": "const inputs = $('Build queries').all();\nconst tav = $('HTTP Request').all();\nconst known = new Set($('Known sites').first().json.known || []);\nconst seen = new Set();\nconst out = [];\ntav.forEach((item, i) => {\n  const meta = (inputs[i] && inputs[i].json) || {};\n  const excluded = meta.excluded || [];\n  for (const r of (item.json.results || [])) {\n    const m = String(r.url || '').match(/^https?:\\/\\/([^\\/?#]+)/i);\n    const host = m ? m[1].replace(/^www\\./, '').toLowerCase() : '';\n    if (!host) continue;\n    if (excluded.some(d => host === d || host.endsWith('.' + d))) continue;\n    if (known.has(host) || seen.has(host)) continue;\n    seen.add(host);\n    out.push({ json: { config_id: meta.config_id, city: meta.city, title: r.title, url: r.url, snippet: (r.content || '').slice(0, 600), host, source: 'search_tavily' } });\n  }\n});\nreturn out.slice(0, 15);"
      },
