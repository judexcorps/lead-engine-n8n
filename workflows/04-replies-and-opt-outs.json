    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with o as (insert into opt_outs (contact_hash, reason) values ($1::text, 'reply STOP') on conflict do nothing),\nl as (update leads set opted_out = true, status = 'unsubscribed' where contact_hash = $1::text returning id)\nupdate followups set status = 'cancelled' where status = 'pending' and lead_id in (select id from l);",
        "options": {
          "queryReplacement": "={{ [$json.contact_hash] }}"
        }
      },
