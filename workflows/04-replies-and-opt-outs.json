    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with m as (insert into messages (lead_id, direction, channel, subject, body) values ($1::uuid, 'in', 'email', $2::text, $3::text)),\nl as (update leads set status = 'replied' where id = $1::uuid and status in ('new','contacted') returning id)\nupdate followups set status = 'cancelled' where status = 'pending' and lead_id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [$json.id, $('Extract sender').item.json.subject, $('Extract sender').item.json.body] }}"
        }
