    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst from = String(j.From || (j.from && j.from.text) || '');\nconst m = from.match(/<([^>]+)>/);\nconst email = (m ? m[1] : from).trim().toLowerCase();\nconst subject = String(j.Subject || j.subject || '');\nconst body = String(j.snippet || j.text || '').trim();\nif (/^(re:\\s*)*(reply received|new hot lead|weekly lead digest|workflow failed)/i.test(subject)) return [];\nconst is_stop = /^\\s*(stop|unsubscribe|remove me|opt[\\s-]?out|please stop)\\b/i.test(body);\nreturn [{ json: { email, subject, body, is_stop } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "9c63fbdd-b044-4483-b852-4943712bde0b",
      "name": "Extract sender"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select id, contact_hash, business_name from leads where lower(email) = $1::text limit 1;",
        "options": {
          "queryReplacement": "={{ [$json.email] }}"
        }
      },
