        "query": "with m as (update messages set sent_at = now() where id = $1::uuid returning lead_id),\nl as (update leads set status = 'contacted', last_contact_at = now() where id = (select lead_id from m) returning id, config_id)\ninsert into followups (lead_id, step, scheduled_at)\nselect l.id, s.ord, now() + make_interval(days => s.d)\nfrom l, businesses_config c, unnest(c.followup_days) with ordinality as s(d, ord)\nwhere c.id = l.config_id\n  and not exists (select 1 from followups f where f.lead_id = l.id);",
