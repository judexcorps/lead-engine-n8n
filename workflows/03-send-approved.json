    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst name = j.business_name || 'there';\nconst texts = {\n  1: `Hi ${name}, a quick follow-up on my earlier note about wholesale sneakers. Happy to send prices and available sizes if that helps. Reply STOP to opt out.`,\n  2: `Hi ${name}, if useful, I can send our current price list. Just reply with the sizes you stock most. Reply STOP to opt out.`,\n  3: `Hi ${name}, last note from me. If wholesale sneakers are not a fit right now, no problem. Reply STOP and I will not message again.`\n};\nreturn { json: { followup_id: j.followup_id, lead_id: j.lead_id, subject: 'Following up: wholesale sneakers', body: texts[j.step] || texts[3] } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        -160
      ],
      "id": "3303056d-f6f5-4378-8954-a32c8d95ba14",
      "name": "Write follow-up"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with ins as (insert into messages (lead_id, direction, channel, subject, body) values ($2::uuid, 'out', 'email', $3::text, $4::text) returning id)\nupdate followups set status = 'sent', sent_at = now() where id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [$json.followup_id, $json.lead_id, $json.subject, $json.body] }}"
