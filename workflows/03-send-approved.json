      "parameters": {
        "operation": "executeQuery",
        "query": "select f.id as followup_id, l.id as lead_id, l.business_name, f.step\nfrom followups f join leads l on l.id = f.lead_id\nwhere f.status = 'pending' and f.scheduled_at <= now()\n  and l.status = 'contacted' and l.opted_out = false and l.email is not null\n  and not exists (select 1 from opt_outs o where o.contact_hash = l.contact_hash)\nlimit 20;",
