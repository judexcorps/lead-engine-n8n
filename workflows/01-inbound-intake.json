        "query": "insert into leads\n  (config_id, lead_type, source, name, contact, contact_hash, message, consent_marketing, consent_at)\nvalues\n  ((select id from businesses_config where name = 'sneakers'),\n   'inbound_individual', 'form', $1, $2, $3, $4, $5::boolean,\n   case when $5::boolean then now() end)\non conflict (config_id, contact_hash) do nothing\nreturning id;",
        "options": {
