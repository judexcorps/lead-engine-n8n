        "jsCode": "let r = { intent: 'unknown', score: 0, reason: 'parse failed' };\ntry {\n  const t = $json.candidates[0].content.parts[0].text;\n  r = JSON.parse(t);\n} catch (e) {}\nconst score = Math.max(0, Math.min(100, parseInt(r.score) || 0));\nreturn { json: { lead_id: $('Insert lead').item.json.id, intent: String(r.intent || 'unknown'), score, reason: String(r.reason || '') } };"
      },
